# `APP_NAME` names the service in logs, metadata, and future health responses.
# This helps identify which process is running when multiple services exist.
APP_NAME=langgraph-multi-agents

# `APP_ENV` describes the runtime environment, such as local development or production.
# The future config loader will use this to adjust behavior or logging defaults.
APP_ENV=development

# `APP_HOST` tells the ASGI server which network interface to bind to at runtime.
# `0.0.0.0` is convenient for local containers and host access.
APP_HOST=0.0.0.0

# `APP_PORT` tells the server which TCP port to listen on.
# The API process will use this when the backend starts serving HTTP traffic.
APP_PORT=8000

# `LOG_LEVEL` controls how verbose runtime logs should be.
# Starting with `INFO` keeps normal flow visible without excessive debug noise.
LOG_LEVEL=INFO

# `MODEL_PROVIDER` selects which provider adapter the application should use.
# We default to `ollama` because local-first development is the current plan.
MODEL_PROVIDER=ollama

# `OLLAMA_BASE_URL` points to the external Ollama HTTP server.
# The future provider layer will call this service when generating model outputs.
OLLAMA_BASE_URL=http://localhost:11434

# `OLLAMA_CHAT_MODEL` selects the default chat-capable model served by Ollama.
# This is kept configurable because local model availability varies by machine.
OLLAMA_CHAT_MODEL=llama3.1

# `GRAPH_MAX_ITERATIONS` limits how many supervisor loops a graph run may take.
# This is a safety setting to prevent runaway routing loops during early development.
GRAPH_MAX_ITERATIONS=6

# `ENABLE_CHECKPOINTER` controls whether later graph state persistence is enabled.
# We start with `false` because phase 1 focuses on an in-memory, easier-to-follow flow.
ENABLE_CHECKPOINTER=false

# `CHECKPOINTER_URL` reserves a place for a future persistence backend.
# It is intentionally blank now because phase 1 does not require long-term graph storage.
CHECKPOINTER_URL=
